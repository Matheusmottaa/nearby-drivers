{
  "uid": "routing-hpa",
  "title": "nearby-drivers",
  "tags": ["nearby-drivers", "k8s"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 7,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "ride-service",
      "description": "Pods prontos. Sobe com 1.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"nearby-drivers\",deployment=\"ride\"})" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "0", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "driver-service",
      "description": "Pods prontos. Sobe com 1.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"nearby-drivers\",deployment=\"driver\"})" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "0", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "matching-service",
      "description": "Pods prontos. Comeca em 1 e sobe ate 3 quando a carga passa de 60% de CPU.",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"nearby-drivers\",deployment=\"matching\"})" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "0", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "routing-service",
      "description": "Pods prontos. Comeca em 2 e sobe ate 4 quando a carga passa de 60% de CPU.",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"nearby-drivers\",deployment=\"routing\"})" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 0, "noValue": "0", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pods",
      "description": "Pods prontos de cada servico. matching-service sobe de 1 ate 3 e routing-service de 2 ate 4, um pod a cada 30s, quando a CPU passa de 60%.",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "ride-service", "expr": "max(kube_deployment_status_replicas_ready{namespace=\"nearby-drivers\",deployment=\"ride\"})" },
        { "refId": "B", "legendFormat": "driver-service", "expr": "max(kube_deployment_status_replicas_ready{namespace=\"nearby-drivers\",deployment=\"driver\"})" },
        { "refId": "C", "legendFormat": "matching-service", "expr": "max(kube_deployment_status_replicas_ready{namespace=\"nearby-drivers\",deployment=\"matching\"})" },
        { "refId": "F", "legendFormat": "matching-service - desejados", "expr": "max(kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"matching\"})" },
        { "refId": "D", "legendFormat": "routing-service", "expr": "max(kube_deployment_status_replicas_ready{namespace=\"nearby-drivers\",deployment=\"routing\"})" },
        { "refId": "E", "legendFormat": "routing-service - desejados", "expr": "max(kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"routing\"})" }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "min": 0, "max": 4, "custom": { "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ride-service" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "driver-service" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "matching-service" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] },
          { "matcher": { "id": "byName", "options": "matching-service - desejados" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] },
          { "matcher": { "id": "byName", "options": "routing-service" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "routing-service - desejados" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU",
      "description": "Porcentagem do CPU pedido. A linha vermelha e o alvo de 60% do matching-service e do routing-service.",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "matching-service - CPU atual", "expr": "max(kube_horizontalpodautoscaler_status_target_metric{horizontalpodautoscaler=\"matching\",metric_name=\"cpu\",metric_target_type=\"utilization\"})" },
        { "refId": "B", "legendFormat": "routing-service - CPU atual", "expr": "max(kube_horizontalpodautoscaler_status_target_metric{horizontalpodautoscaler=\"routing\",metric_name=\"cpu\",metric_target_type=\"utilization\"})" },
        { "refId": "C", "legendFormat": "alvo 60%", "expr": "max(kube_horizontalpodautoscaler_spec_target_metric{horizontalpodautoscaler=\"routing\",metric_name=\"cpu\",metric_target_type=\"utilization\"})" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "custom": { "lineWidth": 2, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "matching-service - CPU atual" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] },
          { "matcher": { "id": "byName", "options": "routing-service - CPU atual" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "alvo 60%" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requisicoes por segundo",
      "description": "Requisicoes por segundo do routing-service no cluster.",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "routing-service", "expr": "sum(rate(k6_http_reqs_total[1m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
